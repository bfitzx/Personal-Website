   // ---------- time + weather (Galway, Open-Meteo — no API key required) ----------
+  const DAILY_WORKOUTS = ['Swim', 'Run', 'Weightlifting', 'Cycling', 'Crossfit', 'Martial Arts'];
+
+  function dublinDateKey(date) {
+    return new Intl.DateTimeFormat('en-CA', {
+      timeZone: 'Europe/Dublin',
+      year: 'numeric',
+      month: '2-digit',
+      day: '2-digit'
+    }).format(date);
+  }
+
+  function hashString(str) {
+    let h = 2166136261;
+    for (let i = 0; i < str.length; i++) {
+      h ^= str.charCodeAt(i);
+      h = Math.imul(h, 16777619);
+    }
+    return h >>> 0;
+  }
+
+  // One workout and one start time per Galway day, from 6:00am through 7:30am.
+  function workoutForDay(date) {
+    const h = hashString(dublinDateKey(date));
+    const name = DAILY_WORKOUTS[h % DAILY_WORKOUTS.length];
+    const offset = (h >>> 8) % 91;
+    const minutes = 6 * 60 + offset;
+    const hour = Math.floor(minutes / 60);
+    const min = String(minutes % 60).padStart(2, '0');
+    return name + ' ' + hour + ':' + min + 'am';
+  }
+
+  function renderDailyWorkout() {
+    const el = document.getElementById('hero-workout');
+    if (el) el.textContent = 'Workout ' + workoutForDay(new Date());
+  }
+
+  function startLiveHr() {
+    const el = document.getElementById('hero-hr-text');
+    if (!el) return;
+    let hr = 60;
+    function render() {
+      el.textContent = 'Live HR ' + hr + 'bpm';
+    }
+    render();
+    setInterval(() => {
+      let delta = Math.random() < 0.4 ? 0 : (Math.random() < 0.5 ? -1 : 1);
+      if (hr <= 56) delta = Math.random() < 0.5 ? 0 : 1;
+      else if (hr >= 66) delta = Math.random() < 0.5 ? 0 : -1;
+      hr += delta;
+      render();
+    }, 1200);
+  }
+
